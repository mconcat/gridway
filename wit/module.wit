package gridway:framework@0.1.0;

/// Generic module interface for application modules (bank, staking, gov, etc.)
///
/// Each module is a WASM component that handles domain-specific messages
/// and queries. Modules access state through the kvstore interface.
interface module {
    /// Message to be handled by the module.
    ///
    /// The type-url identifies the message type using Gridway's module-scoped
    /// naming convention (e.g., "bank.MsgSend", "staking.MsgDelegate").
    /// Legacy Cosmos-style URLs are also accepted for backward compatibility.
    record message {
        /// Message type identifier
        type-url: string,
        /// Message payload as JSON
        data: string,
        /// Sender address (authenticated by the host before dispatch)
        sender: string,
    }

    /// Module execution context
    record module-context {
        /// Current block height
        block-height: u64,
        /// Block timestamp (Unix seconds)
        block-time: u64,
        /// Chain ID
        chain-id: string,
        /// Whether this is a simulation (no state changes persisted)
        simulate: bool,
    }

    /// Response from module execution
    record module-response {
        /// Whether execution succeeded
        success: bool,
        /// Result data as JSON
        data: option<string>,
        /// Events emitted during execution
        events: list<event>,
        /// Error message if failed
        error: option<string>,
        /// Gas consumed by this execution
        gas-used: u64,
    }

    /// Event attribute key-value pair
    record event-attribute {
        key: string,
        value: string,
    }

    /// Event emitted during execution
    record event {
        /// Event type
        event-type: string,
        /// Event attributes
        attributes: list<event-attribute>,
    }

    /// Handle a message
    handle: func(context: module-context, msg: message) -> module-response;

    /// Query module state
    query: func(path: string, data: list<u8>) -> result<list<u8>, string>;
}

world module-world {
    import kvstore;
    export module;
}
